# Device: Nothing Phone 2 (Pong, SM8475)
# GKI 2.0 — Kernel 5.10.246-gki-g4ec5491f6b5f
# This file is sourced by all build scripts — ZERO hardcoded versions.

DEVICE_CODENAME="pong"
DEVICE_MODEL="SM8475"
DEVICE_SOC="sm8475"
DEVICE_ARCH="arm64"
DEVICE_DEFCONFIG="sm8475_defconfig"

# GKI 2.0 requirements
GKI_MAJOR_VERSION="5.10"
GKI_KERNEL_VERSION="5.10.246"
GKI_KMI_TAG="g4ec5491f6b5f"
GKI_BRANCH="common-android13-6.1"
GKI_BRANCH_KLEAF="common-android14-6.1"

# Boot partition — Pong is PRE-init_boot era
BOOT_PARTITION="boot"  # NOT init_boot
BOOT_IMAGE_NAME="boot.img"

# ROM base (for testing/validation)
ROM_NAME="evolution-x-11.11-pong"
ROM_ANDROID_VERSION="16"
ROM_CODENAME="pong"

# Toolchain — Android clang from android.googlesource.com
# Using android-r416183b (AOSP stable) and android-r530567 (2024)
ANDROID_CLANG_REPO="https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86"
ANDROID_CLANG_REF="master-kernel-build-2021"
ANDROID_CLANG_REF_COMMIT="6e3223f76384455acde43affde3df0ea9df66c0d"
ANDROID_CLANG_VERSION="clang-r416183b"
ANDROID_CLANG_VERSION_2024="clang-r530567"
ANDROID_CLANG_2024_REF="main-kernel-build-2024"
LLVM_VERSION="llvm-22.1.8"
LLVM_URL="https://github.com/llvm/llvm-project/releases/download/llvmorg-22.1.8/LLVM-22.1.8-Linux-X64.tar.xz"
LLVM_SHA256="PLACEHOLDER"  # Updated per release

# Kernel source — AOSP common kernel
KERNEL_SOURCE_REPO="https://github.com/aosp-kernel/android_kernel_google_pioneer"
# NOTE: Pioneer = Pixel kernel. Pong may need a different upstream.
# Fallback: use LineageOS or arter97 maintained kernel
KERNEL_SOURCE_REPO_ALT="https://github.com/LineageOS/android_kernel_nothing_sm8475"
KERNEL_SOURCE_REF="lineage-23.2"

# APatch source
APATCH_REPO="https://github.com/bmax121/APatch"
APATCH_REF="v11219"
APATCH_PATCH_DIR="platform/kernel/patches"

# Magisk source
MAGISK_REPO="https://github.com/topjohnwu/Magisk"
MAGISK_REF="v30.7"
MAGISK_PATCH_DIR=""

# KernelSU Next source
KSU_NEXT_REPO="https://github.com/KernelSU-Next/KernelSU-Next"
KSU_NEXT_REF="v3.4.2"
KSU_NEXT_PATCH_DIR=""

# SUSFS (optional — kernel module enhancement)
SUSFS_REPO="https://gitlab.com/simonpunk/susfs4ksu"
SUSFS_BRANCH="gki-android12-5.10"

# Build options
CCACHE_ENABLED="true"
LTO_MODE="thin"  # none | thin | full
BUILD_SCOPE="image-only"  # image-only | full

# AnyKernel3 template
AK3_REPO="https://github.com/osm0sis/AnyKernel3"
AK3_BRANCH="master"

# Output paths
DIST_DIR="out/dist"
OUT_DIR="out/build"
RELEASE_DIR="release"

# Cache keys
CACHE_PREFIX="pong-builder"
CACHE_VERSION="v2"
