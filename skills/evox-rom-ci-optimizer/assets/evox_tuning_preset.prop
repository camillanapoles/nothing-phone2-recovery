# =============================================================================
# EVOX-CI v2.0 — Preset de Otimizacao Pre-Validado (Evolution X 11.11 / API 36)
# =============================================================================

# 1. Compilacao ART / DEX (Android 16 Speed-Profile)
pm.dexopt.install=speed-profile
pm.dexopt.bg-dexopt=speed-profile
dalvik.vm.dex2oat64.enabled=true

# 2. Fluidez de UI, SurfaceFlinger & Taxa de Atualizacao (120Hz Lock)
ro.surface_flinger.use_content_detection_for_refresh_rate=false
ro.surface_flinger.set_touch_timer_ms=200
ro.surface_flinger.set_idle_timer_ms=1000
debug.sf.latch_unsignaled=1

# 3. Rede, Telemetria Reduzida e Economia de Wakelocks
ro.config.nocheckin=1
profiler.force_disable_err_rpt=1
profiler.force_disable_ulog=1
